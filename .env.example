# GEMINI_API_KEY: Required for Gemini AI features (Chatbot, Course AI Tutor, Smart Question Generator).
# Add this in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Override default Gemini model name (defaults to gemini-4-hydrogen with automatic fallback to gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"

# Optional: Override the sole Super Admin email (defaults to haideryouseif68@gmail.com).
# SUPER_ADMIN_EMAIL="haideryouseif68@gmail.com"

# Optional: Override Admin registration secret code.
# ADMIN_SECRET_CODE="MAFIA-ADMIN"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
